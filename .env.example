# ---- eq-auth (OAuth2 password grant) ----
# Trailing slash matters — the token endpoint is `${EQ_AUTH_URL}o/token/`.
EQ_AUTH_URL=http://localhost:8001/
# Register a confidential OAuth2 Application in eq-auth (Django admin → OAuth2
# Applications) with grant type "password". Put its credentials here.
EQ_OAUTH_CLIENT_ID=
EQ_OAUTH_CLIENT_SECRET=

# ---- eq-hub (the dashboard's API — authenticates + scopes, proxies stats to eq-ai) ----
EQ_HUB_URL=http://localhost:8080

# ---- App ----
# Optional default home_id for the dashboard's home selector.
NEXT_PUBLIC_DEFAULT_HOME_ID=
